<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="tvo_bg">#FF0B0B12</color>
    <style name="Theme.TVO" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/tvo_bg</item>
        <item name="android:colorBackground">@color/tvo_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.TVO.Player" parent="Theme.TVO">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
